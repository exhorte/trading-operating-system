# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the documented template is tracked
!.env.example

# vercel
.vercel

# Python caches
__pycache__/
*.pyc

# Data exported from a terminal (`python -m trading_os export-history`, `spread-history`) and personal trading data:
# never source, never committed.
/exports/

# MQL5 compiled binaries and MetaEditor headless-compile logs (EA-05)
tools/mt5-execution-agent/*.ex5
# MT5 input presets saved through the terminal's junction (2026-09-24): they
# carry InpAccountId — an account number never goes into the repository.
tools/mt5-execution-agent/*.set
tools/mt5-execution-agent/compile.log
tools/mt5-execution-agent/*.log
tools/mt5-execution-agent/tradingos_commands*.log


# typescript
*.tsbuildinfo
next-env.d.ts

# T08 — generated weekly review documents (personal trading data, not
# source; regenerate with `python -m trading_os weekly-review`)
/weekly-reviews/

# Python core (ADR 0016): virtualenv and tool caches
python/.venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
*.egg-info/
