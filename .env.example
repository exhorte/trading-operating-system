# Realtime source for the cockpit.
#   unset / "mock" -> MockRealtimeClient (default, used for build & CI)
#   "backend"      -> SignalRRealtimeClient via the ASP.NET Core gateway (production path)
# Runbook: context/backend/backend_bootstrap.md (observer + dotnet run + cockpit).
NEXT_PUBLIC_REALTIME_SOURCE=mock

# SignalR hub of the ASP.NET Core backend (only used when SOURCE=backend).
NEXT_PUBLIC_BACKEND_HUB_URL=http://localhost:5080/hub/cockpit

# Account the mock realtime source presents (only used when SOURCE=mock).
# Unset -> "account-001", a placeholder that exists in no database: the
# HTTP-backed screens (/journal, /positions, /analyse, compliance badge) are
# then empty in the mock preview, because they query the backend by account.
# Set it to one of your own account ids and those screens show that account's
# real rows while equity/positions/ticks stay scripted.
# Never commit a real value here — .env.local is gitignored, this file is not.
# NEXT_PUBLIC_MOCK_ACCOUNT_ID=
